# CORS: Comma-separated list of allowed origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://land-logic-frontend.onrender.com

# Shared API Key: Secures /predict and /api/v1/predict via X-API-Key header.
API_KEY=changeme-in-render

# Concurrency Guard: Maximum concurrent heavy pipeline executions.
MAX_CONCURRENT_REQUESTS=3
