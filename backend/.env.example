# ==============================================================================
# Land Logic DRONE-MAPPING-AI — Backend Environment Configuration Template
# Member 2: Backend & Pipeline Orchestrator (feature/fastapi-backend)
# ==============================================================================

# CORS: Comma-separated list of allowed origins.
# In production, this MUST include your deployed frontend URL (e.g. https://land-logic-frontend.onrender.com).
# In local development, defaults to http://localhost:5173,http://127.0.0.1:5173 if unset.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://land-logic-frontend.onrender.com

# Shared API Key: Secures /predict and /api/v1/predict endpoints via the X-API-Key header.
# REQUIRED: Must be set in production. If unset, the app logs a startup warning and fails closed (401).
API_KEY=changeme-in-render

# Concurrency Guard: Maximum concurrent heavy pipeline executions (stitching + AI + GIS)
# Render free/starter tiers have limited vCPU/RAM; defaults to 3. Requests exceeding this return HTTP 503.
MAX_CONCURRENT_REQUESTS=3
